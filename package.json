{
  "name": "quickbase-mcp-server",
  "version": "2.0.0",
  "description": "Model Context Protocol (MCP) server for the Quickbase JSON REST API: apps, tables, fields, records, relationships, reports, files and code pages.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "quickbase-mcp-server": "dist/index.js",
    "quickbase-deploy-codepage": "dist/cli/deploy.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "quickbase",
    "api",
    "database",
    "low-code"
  ],
  "author": "Lawrence Cirillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-zellner/QuickBase-MCP-Server.git"
  },
  "bugs": {
    "url": "https://github.com/mark-zellner/QuickBase-MCP-Server/issues"
  },
  "homepage": "https://github.com/mark-zellner/QuickBase-MCP-Server#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
