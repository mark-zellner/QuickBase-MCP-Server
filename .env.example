# Copy to .env for local runs, or pass these through your MCP client's "env" block.
# Never commit real tokens. .env is git-ignored.

# --- Required ---------------------------------------------------------------
# Realm hostname, e.g. mycompany.quickbase.com (a full https:// URL is accepted too)
QB_REALM=yourrealm.quickbase.com
# Quickbase user token: My Preferences -> Manage user tokens
QB_USER_TOKEN=your_user_token_here

# --- Optional ---------------------------------------------------------------
# Default app (DBID). Tools that work on an app accept an `appId` argument too.
QB_APP_ID=
# Per-request timeout in milliseconds (default 30000)
QB_DEFAULT_TIMEOUT=30000
# Retries for 429 and transient failures (default 3, max 10)
QB_MAX_RETRIES=3
# Set to true to register read-only tools only (no create/update/delete/deploy)
QB_READ_ONLY=false

# --- Code page tools --------------------------------------------------------
# Tables that store code pages and their version history (see README)
CODEPAGE_TABLE_ID=
CODEPAGE_VERSION_TABLE_ID=
# deploy_codepage / quickbase-deploy-codepage may only read files under this directory
# (default: the server's working directory)
QB_WORKSPACE_DIR=
